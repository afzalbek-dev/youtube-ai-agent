# ==============================================================================
# YouTube AI Agent Configuration Environment Variables
# Copy this file to .env and provide your specific credentials.
# NEVER commit the actual .env file to Git!
# ==============================================================================

# Application & Environment Mode
APP_ENV=development
LOG_LEVEL=INFO
DRY_RUN=true

# AI Provider Settings (Gemini / Google AI Studio)
# Leave empty or set to dummy value to use the deterministic offline fallback generator
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Video Synthesis Settings
OUTPUT_DIR=output
TEMP_DIR=temp
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
MAX_DURATION_SECONDS=60
DEFAULT_SCENE_DURATION_SECONDS=5

# Quality Control Thresholds
MAX_BLACK_FRAME_RATIO=0.08
SIMILARITY_HASH_THRESHOLD=5
MIN_AUDIO_DURATION_RATIO=0.85

# Telegram Notification Settings (Optional)
# If left empty, notifications will be logged locally instead of sent
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=false

# YouTube Data API Settings (Upload is DISABLED by default)
# YOUTUBE_UPLOAD_ENABLED must be explicitly set to 'true' to allow uploads
YOUTUBE_UPLOAD_ENABLED=false
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_TOKEN_FILE=token.json
YOUTUBE_PRIVACY_STATUS=private
